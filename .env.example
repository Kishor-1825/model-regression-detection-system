# OpenAI API Key (leave empty to use deterministic offline mock evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Slack Incoming Webhook URL for CI/CD alerts (leave empty or set your real webhook)
SLACK_WEBHOOK_URL=

# Optional: Custom Report URL base (e.g. GitHub Actions artifact or S3 link)
REPORT_URL_BASE=http://localhost:8000/report/diff_report.html
